# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI Study Companion"
APP_VERSION="1.0.0"

# Security & Authentication
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_study_companion
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_study_companion

# Background Processing (Redis & Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Provider (OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Storage (Local for dev, S3 compatible for production)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage/uploads

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
